<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardBackgroundColor="?attr/colorSurfaceContainerLow"
    app:cardElevation="0dp"
    app:cardCornerRadius="20dp"
    app:strokeColor="?attr/colorOutlineVariant"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Name + running chip -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvWsName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="?android:textColorPrimary" />

                <TextView
                    android:id="@+id/tvWsMeta"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="13sp"
                    android:textColor="?android:textColorSecondary"
                    android:layout_marginTop="6dp" />

            </LinearLayout>

            <com.google.android.material.chip.Chip
                android:id="@+id/chipWsRunning"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/Widget.Material3.Chip.Filter"
                android:checkable="false"
                android:clickable="false"
                app:checkedIconVisible="false"
                android:text="@string/running" />

        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnWsRepair" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="@string/workspace_repair_label"
            android:layout_marginTop="12dp"
            style="@style/Widget.Material3.Button.TextButton" />
        <com.google.android.material.button.MaterialButton android:id="@+id/btnWsPrivatePolicy"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:visibility="gone" android:text="@string/private_startup_policy"
            style="@style/Widget.Material3.Button.OutlinedButton" />
        <!-- Action buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnWsStartStop"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/start_button"
                style="@style/Widget.Material3.Button.TonalButton" />

            <Space
                android:layout_width="8dp"
                android:layout_height="1dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnWsRemove"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/workspace_remove_label"
                style="@style/Widget.Material3.Button.OutlinedButton"
                app:strokeColor="?attr/colorOutlineVariant"
                android:textColor="?attr/colorError" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
